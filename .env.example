# Copy to `.env.local` (git-ignored) and fill in the values you want.
# Both integrations are optional — the dashboard runs with neither set, and each
# stays invisible until its variable has a value. Vite reads env only at boot,
# so restart `npm run dev` after editing.

# Clerk publishable key — turns on sign-in and per-account storage.
# https://dashboard.clerk.com → your app → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Google OAuth client id — turns on Calendar sync in the Reminders widget.
# https://console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application, with `http://localhost:5173` as an
# authorised JavaScript origin and no redirect URI.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Spotify client id — turns on the in-page player (volume + transport) in the
# Spotify panel. Requires a Spotify Premium account; free accounts keep the
# embedded player. https://developer.spotify.com/dashboard → Create app, then
# add BOTH redirect URIs you use, exactly:
#   http://127.0.0.1:5173/          (local dev)
#   https://<user>.github.io/my-dashboard/   (deployed)
VITE_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — turns on the Mail panel, which asks Claude which three
# messages most deserve your attention. Needs VITE_GOOGLE_CLIENT_ID too (Gmail
# is read through the same OAuth client), and the Gmail API enabled on that
# Google Cloud project. https://platform.claude.com → API keys
#
# READ THIS BEFORE SETTING IT. Unlike every other value in this file, an
# Anthropic key is a real credential: whoever holds it spends your money. It is
# safe here ONLY because `.env.local` is git-ignored and this variable is
# deliberately NOT wired into `.github/workflows/deploy.yml` — so it reaches a
# local `npm run dev` and never the deployed bundle. Adding it as a repository
# variable or secret would publish it in `dist/assets/*.js` for anyone to read.
# On the deployed site, paste a key into the panel instead (ADR 0009).
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# The OAuth client secret is deliberately absent. This app is client-only
# (ADR 0001/0002) and uses the GIS token flow, which needs no secret — and
# anything prefixed `VITE_` is inlined into the browser bundle, so a secret
# here would be published, not protected.
